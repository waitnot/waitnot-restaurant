{
  "name": "waitnot-staff-dashboard",
  "version": "3.15.0-w",
  "description": "WaitNot Staff Dashboard Desktop Application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "rebuild": "electron-rebuild -v 28.3.3 -w better-sqlite3",
    "postinstall": "electron-rebuild -v 28.3.3 -w better-sqlite3",
    "build": "electron-builder",
    "build-win": "electron-builder --win",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --publish=never",
    "release": "electron-builder --win --publish=always"
  },
  "keywords": ["restaurant", "management", "waitnot", "staff", "orders"],
  "author": "WaitNot Team",
  "license": "MIT",
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "better-sqlite3": "^9.4.3",
    "electron-updater": "^6.1.7",
    "node-thermal-printer": "^4.3.3",
    "pdf-to-printer": "^5.3.1"
  },
  "build": {
    "appId": "com.waitnot.staff",
    "productName": "WaitNot Staff",
    "copyright": "Copyright 2024 WaitNot Team",
    "directories": {
      "output": "D:\\\\WaitNot-out",
      "buildResources": "build"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "waitnot",
        "repo": "waitnot-restaurant",
        "releaseType": "release"
      }
    ],
    "files": [
      "logo.ico",
      "main.js",
      "preload.js",
      "printer.js",
      "escpos-builder.js",
      "offline-db.js",
      "sync-engine.js",
      "upload-engine.js",
      "remote-config.js",
      "printer-settings.html",
      "fallback.html",
      "OFFLINE_IMPLEMENTATION_STATUS.md",
      "OFFLINE_PHASE_1_PLAN.md",
      "renderer/**/*",
      "fonts/**/*",
      "sounds/**/*",
      "logo.png",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        { "target": "nsis",     "arch": ["x64"] }
      ],
      "icon": "logo.ico",
      "requestedExecutionLevel": "asInvoker",
      "publisherName": "WaitNot Team",
      "verifyUpdateCodeSignature": false,
      "signAndEditExecutable": false,
      "sign": null
    },
    "electronLanguages": ["en-US", "en"],
    "afterPack": "./afterpack.js",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "WaitNot Staff",
      "runAfterFinish": true,
      "menuCategory": "WaitNot",
      "deleteAppDataOnUninstall": false,
      "perMachine": false,
      "artifactName": "WaitNot-Staff-Setup-${version}.${ext}",
      "uninstallDisplayName": "WaitNot Staff Dashboard"
    },
    "portable": {
      "artifactName": "WaitNot-Staff-Portable-${version}.${ext}"
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["x64", "arm64"] }],
      "category": "public.app-category.business",
      "icon": "logo.png"
    },
    "linux": {
      "target": [{ "target": "AppImage", "arch": ["x64"] }],
      "category": "Office",
      "icon": "logo.png"
    }
  }
}
