{
  "name": "waitnot-restaurant-app",
  "version": "1.0.0",
  "description": "WaitNot Restaurant Management Desktop Application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build-win": "electron-builder --win",
    "build-mac": "electron-builder --mac",
    "build-linux": "electron-builder --linux",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --publish=never"
  },
  "keywords": ["restaurant", "management", "waitnot", "pos", "orders"],
  "author": "WaitNot Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "electron-updater": "^6.1.7",
    "node-thermal-printer": "^4.3.3",
    "pdf-to-printer": "^5.3.1"
  },
  "build": {
    "appId": "com.waitnot.restaurant",
    "productName": "WaitNot Restaurant",
    "copyright": "Copyright © 2024 WaitNot Team",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "printer.js",
      "fallback.html",
      "renderer/**/*",
      "sounds/**/*",
      "logo.png",
      "node_modules/**/*"
    ],
    "win": {
      "target": [{"target": "nsis", "arch": ["x64", "ia32"]}],
      "icon": "logo.png",
      "requestedExecutionLevel": "asInvoker",
      "publisherName": "WaitNot Team",
      "verifyUpdateCodeSignature": false
    },
    "mac": {
      "target": [{"target": "dmg", "arch": ["x64", "arm64"]}],
      "category": "public.app-category.business",
      "icon": "logo.png"
    },
    "linux": {
      "target": [{"target": "AppImage", "arch": ["x64"]}],
      "category": "Office",
      "icon": "logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "WaitNot Restaurant",
      "runAfterFinish": true,
      "menuCategory": "WaitNot",
      "deleteAppDataOnUninstall": false,
      "perMachine": false,
      "artifactName": "${productName} Setup ${version}.${ext}",
      "uninstallDisplayName": "${productName}"
    }
  }
}
